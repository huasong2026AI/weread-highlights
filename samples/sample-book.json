    { "bookId": "b35326a0813abab07g0115b3", "bookmarkId": "s6", "chapterUid": 2, "range": "700-718", "markText": "示例划线 6：你所羡慕的生活，背后都有你不曾看见的忍耐。", "totalCount": 312, "userVid": 1006 },
